# Gradle cache
.gradle/

# Compiled intermediates (not release jars)
bin/
build/classes/
build/resources/
build/reports/
build/tmp/
build/generated/
build/sources.txt
*.class

# IDE
.idea/
*.iml
.vscode/
*.code-workspace

# OS
.DS_Store
Thumbs.db

# Javac arg files
javac.*.args

# Logs
*.log

# General build output
target/
out/
cache/

# Claude Code local project settings (machine-specific)
.claude/

# Old release jars — only the current release jar is tracked in build/
build/Bits-*.jar
build/Bops-*.jar

# Note: only the current release jar (build/Bops-<version>.jar) is intentionally tracked
# Note: gradlew and gradle/wrapper/ are intentionally tracked
